# === Miya ===
# Claude Agent SDK shu kalitni ishlatadi.
ANTHROPIC_API_KEY=sk-ant-...

# === Ovoz: matnga (STT) va ovozga (TTS) ===
# ElevenLabs — o'zbek tilini ham STT (Scribe), ham TTS (multilingual) da qo'llaydi.
# DIQQAT: kalit `sk_` bilan boshlanadi va faqat yaratilgan paytda bir marta
# ko'rsatiladi. Ro'yxatda ko'rinadigan uzun raqam — bu kalit emas, uning ID si.
ELEVENLABS_API_KEY=

# Mohir.ai — o'zbek tiliga ixtisoslashgan mahalliy provayder (ixtiyoriy, aniqrog'i).
MOHIR_API_KEY=

# Azure Speech — uz-UZ-MadinaNeural / uz-UZ-SardorNeural ovozlari (ixtiyoriy).
AZURE_SPEECH_KEY=
AZURE_SPEECH_REGION=

# === Kanallar ===
# Telegram BOT — faqat sizga xabar yuborish uchun (ixtiyoriy).
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Telegram HISOBI — Jarvis Telegramda siz qila oladigan hamma ishni qilishi
# uchun: kanal/guruh ochish, odam qo'shish, admin qilish, papka yig'ish,
# kanallarni o'qish. Bot bilan bularning hech biri mumkin emas.
#
# Olish: my.telegram.org > API development tools > yangi ilova yarating.
# Keyin bir marta kiring:  python -m jarvis telegram-login
TELEGRAM_API_ID=
TELEGRAM_API_HASH=

# n8n webhook (ixtiyoriy, oldingi avtomatlashtirishlaringizga ulash uchun)
N8N_WEBHOOK_URL=
